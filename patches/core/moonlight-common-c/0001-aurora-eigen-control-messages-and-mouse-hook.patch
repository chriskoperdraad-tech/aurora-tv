diff --git a/src/Limelight.h b/src/Limelight.h
index 0ef42b9..986578c 100644
--- a/src/Limelight.h
+++ b/src/Limelight.h
@@ -1029,6 +1029,21 @@ typedef struct _SS_HDR_METADATA {
 // function when HDR mode is active on the host. This is a Sunshine protocol extension.
 bool LiGetHdrMetadata(PSS_HDR_METADATA metadata);
 
+// Aurora Eigen: raw control stream messages, for host extensions such as Rubylight's
+// (0x553B text input). The callback gets every message type this library does not handle
+// itself, on the control stream's receive thread; payload excludes the type header.
+typedef void(*ConnListenerUnknownControlMessage)(unsigned short type, const unsigned char* payload, int length);
+void LiSetUnknownControlMessageCallback(ConnListenerUnknownControlMessage callback);
+
+// Aurora Eigen: sends one message on the (encrypted) control stream, reliably, on the generic
+// channel. Returns 0 on success, -1 if sending failed and -2 if there is no ENet control stream.
+int LiSendControlStreamMessage(unsigned short type, const void* payload, unsigned short length);
+
+// Aurora Eigen: called at the start of every LiSendMouseButtonEvent, on the caller's thread,
+// before the event is sent (the soft keyboard uses left presses to ask again for text fields).
+typedef void(*ConnListenerMouseButtonHook)(char action, int button);
+void LiSetMouseButtonHook(ConnListenerMouseButtonHook hook);
+
 // This function requests an IDR frame from the host. Typically this is done using DR_NEED_IDR, but clients
