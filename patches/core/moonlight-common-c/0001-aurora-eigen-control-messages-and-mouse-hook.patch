+++ b/src/ControlStream.c
@@ -109,6 +109,7 @@ static PLT_THREAD asyncCallbackThread;
 static uint32_t lastGoodFrame;
 static uint32_t lastSeenFrame;
 static bool stopping;
+static ConnListenerUnknownControlMessage unknownControlMessageCallback;
 static bool disconnectPending;
 static bool encryptedControlStream;
 static bool hdrEnabled;
@@ -1406,6 +1407,11 @@ static void controlReceiveThreadFunc(void* context) {
                 free(ctlHdr);
                 return;
             }
+            else if (unknownControlMessageCallback != NULL && packetLength >= (int)sizeof(*ctlHdr)) {
+                // Aurora Eigen: hand host extension messages (Rubylight's 0x55xx) to the client.
+                unknownControlMessageCallback(ctlHdr->type, (const unsigned char*)ctlHdr + sizeof(*ctlHdr),
+                                              packetLength - (int)sizeof(*ctlHdr));
+            }
 
             free(ctlHdr);
         }
@@ -2116,3 +2122,16 @@ bool LiGetHdrMetadata(PSS_HDR_METADATA metadata) {
     *metadata = hdrMetadata;
     return true;
 }
+
+// Aurora Eigen: see Limelight.h.
+void LiSetUnknownControlMessageCallback(ConnListenerUnknownControlMessage callback) {
+    unknownControlMessageCallback = callback;
+}
+
+int LiSendControlStreamMessage(unsigned short type, const void* payload, unsigned short length) {
+    if (peer == NULL || stopping) {
+        return -2;
+    }
+    return sendMessageAndForget((short)type, (short)length, payload, CTRL_CHANNEL_GENERIC,
+                                ENET_PACKET_FLAG_RELIABLE, false) ? 0 : -1;
+}
